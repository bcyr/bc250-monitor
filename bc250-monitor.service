[Unit]
Description=BC-250 thermal telemetry and guard
After=network.target ollama.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/bc250-monitor/monitor.py
# Optional overrides (see README): BC250_MON_PORT, BC250_MON_BIND, BC250_OLLAMA_URL,
# BC250_GUARD, BC250_GUARD_WARN, BC250_GUARD_CRIT, BC250_MON_RETENTION_DAYS
EnvironmentFile=-/etc/default/bc250-monitor
Restart=always
RestartSec=5
Nice=10

# Runs as a throwaway unprivileged user; the database lives in /var/lib/bc250-monitor.
DynamicUser=yes
StateDirectory=bc250-monitor
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
